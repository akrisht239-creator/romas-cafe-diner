/* ============================================================
   ROMA'S CAFÉ DINER — Premium Editorial Restaurant Stylesheet
   ============================================================ */
:root {
  --bg: #f6f1e7;
  --bg-deep: #efe7d7;
  --ink: #211a13;
  --ink-soft: #55493c;
  --muted: #7a6f60;
  --line: #ddd2bd;
  --accent: #a4501f;
  --accent-deep: #7e3a12;
  --accent-light: #d89b6a;
  --paper: #fbf8f1;
  --dark: #171208;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --container: 1180px;
  --gutter: clamp(16px, 4vw, 48px);
  --radius: 3px;
}
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-weight: 400; line-height: 1.7; font-size: 16px; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; overflow-x: hidden; }
img { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }
address { font-style: normal; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
::selection { background: var(--accent); color: var(--paper); }
.container { width: min(var(--container), 100% - (var(--gutter) * 2)); margin-inline: auto; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 400; line-height: 1.1; letter-spacing: -0.01em; color: var(--ink); }
h1 { font-size: clamp(2.4rem, 6.5vw, 5rem); }
h2 { font-size: clamp(1.8rem, 4vw, 3.2rem); }
h3 { font-size: clamp(1.1rem, 1.8vw, 1.35rem); line-height: 1.25; }
.eyebrow { font-family: var(--font-body); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.24em; color: var(--accent); margin-bottom: 1rem; display: block; }
h2 em, .hero-title em { font-style: italic; color: var(--accent); }
.section { padding-block: clamp(60px, 10vw, 130px); }
.section-head { max-width: 620px; margin-bottom: clamp(36px, 6vw, 72px); }

/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.82rem 1.65rem; border-radius: var(--radius); font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border: 1.5px solid transparent; cursor: pointer; transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease; white-space: nowrap; }
.btn:active { transform: scale(0.97); }
.btn-solid { background: var(--accent); color: var(--paper); }
.btn-solid:hover { background: var(--accent-deep); transform: translateY(-2px); }
.btn-outline { border-color: currentColor; color: inherit; background: transparent; }
.btn-outline:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.btn-ghost { color: var(--paper); border-color: rgba(255,255,255,0.5); background: transparent; }
.btn-ghost:hover { border-color: var(--paper); background: rgba(255,255,255,0.1); }

/* Header */
.site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding-block: 16px; transition: background 0.35s ease, box-shadow 0.35s ease, padding-block 0.35s ease; }
.site-header.scrolled { background: rgba(246,241,231,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 1px 0 var(--line); padding-block: 8px; }
.header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1.1; flex-shrink: 0; }
.brand-name { font-family: var(--font-display); font-size: 1.5rem; color: var(--paper); transition: color 0.35s ease; }
.brand-sub { font-size: 0.58rem; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(255,255,255,0.7); margin-top: 2px; transition: color 0.35s ease; }
.site-header.scrolled .brand-name { color: var(--ink); }
.site-header.scrolled .brand-sub { color: var(--muted); }
.site-header.scrolled .site-nav a { color: var(--ink-soft); }
.site-header.scrolled .site-nav a:hover { color: var(--accent); }
.site-header.scrolled .header-call { color: var(--ink); }
.site-header.scrolled .nav-toggle span { background: var(--ink); }
.site-nav { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); }
.site-nav a { color: rgba(255,255,255,0.85); font-size: 0.82rem; font-weight: 500; letter-spacing: 0.04em; position: relative; padding-bottom: 3px; transition: color 0.25s ease; }
.site-nav a::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.3s ease; }
.site-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
.site-nav a:hover { color: var(--paper); }
.header-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
.header-call { color: rgba(255,255,255,0.9); font-size: 0.72rem; padding: 0.55rem 1.1rem; }
.site-header.scrolled .header-call:hover { background: var(--ink); color: var(--paper); }
.nav-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 6px; z-index: 110; }
.nav-toggle span { display: block; width: 22px; height: 2px; background: var(--paper); border-radius: 2px; transition: transform 0.3s ease, opacity 0.3s ease, background 0.35s ease; }
.nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-toggle.open span:nth-child(2) { opacity: 0; }
.nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Hero */
.hero { position: relative; min-height: 100svh; min-height: 100vh; display: grid; place-items: end start; overflow: hidden; }
.hero-media { position: absolute; inset: 0; background-image: linear-gradient(rgba(20,14,8,0.4), rgba(20,14,8,0.55) 60%, rgba(20,14,8,0.78)), url("https://images.unsplash.com/photo-1493857671505-72967e2e2760?auto=format&fit=crop&w=1920&q=80"); background-size: cover; background-position: center 30%; animation: heroZoom 18s ease-out forwards; will-change: transform; }
@keyframes heroZoom { from { transform: scale(1.06); } to { transform: scale(1); } }
.hero-overlay { position: absolute; inset: 0; }
.hero-content { position: relative; z-index: 2; padding-bottom: clamp(48px, 8vh, 100px); color: var(--paper); max-width: 700px; }
.hero-title { font-size: clamp(2.4rem, 6.5vw, 5rem); max-width: 14ch; margin-bottom: 1.3rem; }
.hero-lede { max-width: 50ch; font-weight: 300; font-size: clamp(0.9rem, 1.3vw, 1.05rem); color: rgba(255,255,255,0.85); margin-bottom: 2rem; line-height: 1.8; }
.hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 2.4rem; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.65); }

/* Marquee */
.marquee { border-block: 1px solid var(--line); background: var(--paper); overflow: hidden; padding-block: 14px; }
.marquee-track { display: flex; align-items: center; gap: 26px; white-space: nowrap; width: max-content; animation: marqueeScroll 36s linear infinite; }
.marquee-track span { font-family: var(--font-display); font-size: 1rem; font-style: italic; color: var(--ink-soft); }
.marquee-track i { color: var(--accent); font-style: normal; font-size: 0.7rem; }
@keyframes marqueeScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* Story */
.story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 7vw, 90px); align-items: center; }
.story-media { margin: 0; }
.story-media img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
.story-copy p + p { margin-top: 1.1rem; color: var(--ink-soft); }
.story-copy h2 { margin-bottom: 1.4rem; }
.years-badge { display: inline-flex; align-items: center; gap: 16px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 24px; margin-top: 2rem; }
.years-number { font-family: var(--font-display); font-size: clamp(2.2rem, 3.5vw, 3rem); font-weight: 500; color: var(--accent); line-height: 1; }
.years-text { display: flex; flex-direction: column; gap: 2px; }
.years-text strong { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em; }
.years-text span { font-size: 0.75rem; color: var(--muted); }
.story-facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: clamp(20px, 4vw, 52px); margin-top: 2.2rem; padding-top: 2rem; border-top: 1px solid var(--line); }
.story-facts strong { display: block; font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 2rem); font-weight: 500; color: var(--accent); }
.story-facts span { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); }

/* Kitchen / Menu */
.kitchen { background: var(--bg-deep); }
.dish-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 36px); }
.dish-card { background: var(--paper); border: 1px solid var(--line); overflow: hidden; transition: transform 0.35s ease, box-shadow 0.35s ease; }
.dish-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px -20px rgba(33,26,19,0.25); }
.dish-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: saturate(0.92); transition: transform 0.6s ease; }
.dish-card:hover img { transform: scale(1.04); }
.dish-info { padding: 20px 22px 24px; }
.dish-info h3 { margin: 0; }
.dish-info p { margin-top: 6px; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.6; }
.menu-note { margin-top: clamp(28px, 5vw, 48px); text-align: center; font-size: 0.88rem; color: var(--muted); }
.menu-note a { color: var(--accent); font-weight: 600; border-bottom: 1px solid currentColor; transition: opacity 0.25s ease; }
.menu-note a:hover { opacity: 0.7; }

/* Ratings */
.ratings { background: var(--ink); color: var(--bg); }
.ratings .eyebrow { color: var(--accent-light); }
.ratings h2 { color: var(--bg); }
.rating-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 32px); }
.rating-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); text-align: center; transition: background 0.3s ease; }
.rating-card:hover { background: rgba(255,255,255,0.1); }
.rating-source { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.18em; color: rgba(246,241,231,0.5); margin-bottom: 12px; }
.rating-number { font-family: var(--font-display); font-size: clamp(2.4rem, 4vw, 3.2rem); font-weight: 500; line-height: 1; color: var(--bg); }
.rating-star { color: var(--accent-light); font-size: 0.7em; }
.rating-count { margin-top: 8px; font-size: 0.82rem; color: rgba(246,241,231,0.6); }
.rating-bar { margin-top: 16px; height: 3px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; }
.rating-fill { height: 100%; background: var(--accent-light); border-radius: 3px; transition: width 1.2s cubic-bezier(0.2,0.65,0.25,1); }

/* Experience */
.exp-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.exp-item { padding: clamp(24px, 3.5vw, 40px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 0.3s ease; }
.exp-item:hover { background: var(--paper); }
.exp-num { font-family: var(--font-display); font-style: italic; color: var(--accent); font-size: 0.95rem; }
.exp-item h3 { margin: 12px 0 8px; }
.exp-item p { font-size: 0.9rem; color: var(--ink-soft); line-height: 1.65; }

/* Visit Us */
.visit { background: var(--ink); color: var(--bg); }
.visit .eyebrow { color: var(--accent-light); }
.visit h2 { color: var(--bg); }
.visit-top { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
.visit-copy h2 { margin-bottom: 1.2rem; }
.address { margin: 1.4rem 0 1.6rem; color: rgba(246,241,231,0.78); line-height: 1.9; font-size: 0.95rem; }
.hours { margin-bottom: 2rem; }
.hours div { display: flex; justify-content: space-between; max-width: 400px; padding: 10px 0; border-top: 1px solid rgba(246,241,231,0.12); font-size: 0.88rem; }
.hours dt { color: rgba(246,241,231,0.5); }
.hours dd { font-weight: 500; }
.visit-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.visit-actions .btn-outline { color: rgba(246,241,231,0.85); }
.visit-actions .btn-outline:hover { background: var(--bg); color: var(--ink); border-color: var(--bg); }
.visit-mail { display: inline-block; margin-top: 1.2rem; color: var(--accent-light); font-size: 0.92rem; border-bottom: 1px solid transparent; transition: border-color 0.25s ease; }
.visit-mail:hover { border-color: var(--accent-light); }
.visit-map { width: 100%; aspect-ratio: 4 / 3; border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius); overflow: hidden; }
.visit-map iframe { width: 100%; height: 100%; border: 0; display: block; }

/* Contact */
.contact { text-align: center; background: var(--bg); }
.contact-inner { max-width: 680px; }
.contact-body { color: var(--ink-soft); font-size: 1.05rem; max-width: 48ch; margin: 0 auto 2.5rem; line-height: 1.8; }
.contact-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 20px); margin-bottom: 2.5rem; }
.contact-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: clamp(18px, 3vw, 28px) 16px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: background 0.3s ease, transform 0.3s ease; }
.contact-card:hover { background: var(--bg-deep); transform: translateY(-3px); }
.contact-card-icon { font-size: 1.6rem; }
.contact-card strong { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
.contact-card span:last-child { font-size: 0.82rem; color: var(--muted); }
.contact-numbers { padding-top: 2rem; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); }
.contact-numbers p + p { margin-top: 8px; }
.contact-numbers a { color: var(--ink-soft); font-weight: 500; transition: color 0.25s ease; }
.contact-numbers a:hover { color: var(--accent); }

/* Footer */
.site-footer { background: var(--dark); color: rgba(246,241,231,0.7); padding-top: clamp(44px, 6vw, 72px); }
.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: clamp(28px, 5vw, 60px); padding-bottom: clamp(36px, 5vw, 60px); }
.foot-brand .brand-name { font-family: var(--font-display); font-size: 1.8rem; color: var(--bg); display: block; margin-bottom: 10px; }
.foot-brand p { font-size: 0.88rem; line-height: 1.8; }
.foot-nav { display: flex; flex-direction: column; gap: 8px; }
.foot-nav a { color: rgba(246,241,231,0.65); font-size: 0.88rem; transition: color 0.25s ease; }
.foot-nav a:hover { color: var(--accent-light); }
.foot-contact { display: flex; flex-direction: column; gap: 8px; }
.foot-contact a { color: rgba(246,241,231,0.65); font-size: 0.88rem; transition: color 0.25s ease; }
.foot-contact a:hover { color: var(--accent-light); }
.footer-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-block: 20px; border-top: 1px solid rgba(246,241,231,0.1); font-size: 0.75rem; color: rgba(246,241,231,0.4); }

/* Back to top */
.back-to-top { position: fixed; bottom: 24px; right: 24px; z-index: 80; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--paper); font-size: 1.1rem; border-radius: var(--radius); opacity: 0; visibility: hidden; transition: opacity 0.35s ease, visibility 0.35s ease, background 0.25s ease; text-decoration: none; }
.back-to-top.visible { opacity: 1; visibility: visible; }
.back-to-top:hover { background: var(--accent); }

/* Reveal */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.75s cubic-bezier(0.2,0.65,0.25,1), transform 0.75s cubic-bezier(0.2,0.65,0.25,1); }
.reveal.visible { opacity: 1; transform: none; }

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .marquee-track { animation: none; }
  .hero-media { animation: none; }
  .dish-card { transition: none; }
  .dish-card:hover { transform: none; box-shadow: none; }
  .contact-card { transition: none; }
  .contact-card:hover { transform: none; }
  .rating-fill { transition: none; }
}

/* Large desktop */
@media (min-width: 1200px) { .hero-content { padding-left: clamp(0px, 4vw, 80px); } }

/* Tablet */
@media (max-width: 960px) {
  .story-grid, .visit-top { grid-template-columns: 1fr; gap: clamp(28px, 5vw, 52px); }
  .story-media img { aspect-ratio: 16 / 9; }
  .dish-grid { grid-template-columns: repeat(2, 1fr); }
  .rating-grid { grid-template-columns: repeat(3, 1fr); }
  .exp-grid { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

